# MindMate backend — copy this file to `.env` and fill in real values.
# `.env` is gitignored. NEVER commit your real .env to git.

# ---- Server ----
# Port the Express server listens on (3000 for local dev).
PORT=3000

# Public URL of the FRONTEND. Used to lock down CORS in production.
# Comma-separated for multiple origins. Defaults to localhost:5173 if unset.
CORS_ORIGINS=http://localhost:5173

# Set NODE_ENV=production when deploying so Express tightens up its behaviour.
NODE_ENV=development

# ---- Database (MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=Mindmate

# ---- Auth ----
# Long random string (32+ chars). Generate with: openssl rand -hex 48
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# ---- File uploads (avatar storage) ----
# In local dev, uploads go to backend/uploads/avatars/.
# In production, set these three to use Cloudinary instead. Leave blank for local.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
